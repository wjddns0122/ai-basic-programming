   "source": [
    "#matplotlib이랑 numpy를 이용해서 y = 4x^3 + 2x^2 + x + 3 그려줘\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def func(x):\n",
    "    y = 4*x**3 + 2*x**2 + x + 3\n",
    "    return y\n",
    "\n",
    "x = np.linspace(-2, 2)\n",
    "y = func(x)\n",
    "plt.plot(x,y)\n",
    "plt.xlabel(\"x\", size=14)\n",
    "plt.ylabel(\"y\", size=14)\n",
    "plt.grid()\n",
    "plt.show()\n"
   ]
